    overflow: auto;
}

/* Scrollable Help Panel */
ScrollableHelp {
    background: #101010;
    color: #d4d4d4;
    border: solid #65726eff;
    padding: 0;
    height: 1fr;
    scrollbar-color: #738881ff #222222;
    scrollbar-size: 1 1;
}

/* Help content inside the scrollview */
ScrollableHelp > Static {
    background: #101010;
    color: #d4d4d4;
    padding: 1;
    width: 100%;
    height: auto;
}

/* Selected files pop more */
DirectoryTree > .highlight {
    background: #00ffae;
